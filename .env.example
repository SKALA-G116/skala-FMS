# Native local PostgreSQL uses the current OS user; change this for your DB.
DATABASE_URL=postgresql://localhost:55432/food_agent
FOOD_DATA_DIR=.local/assets
FOOD_SESSION_SECURE=false
# Replace before seeding. Tests set their own fixture password explicitly.
FOOD_SEED_PASSWORD=change-me-before-seeding
FOOD_ANALYSIS_MODE=agent
FOOD_MODEL_URL=http://127.0.0.1:11434
FOOD_MODEL_NAME=qwen3:8b
FOOD_MODEL_CONCURRENCY=1
FOOD_MODEL_TIMEOUT_SECONDS=240
FOOD_OCR_ENABLED=false
# Optional Python 3.11 PaddleOCR environment; see readmd.md.
# FOOD_OCR_PYTHON=/absolute/path/to/.venv-ocr/bin/python
