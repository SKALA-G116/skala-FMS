{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Food extraction DTO v1",
  "type": "object",
  "required": [
    "dto_schema",
    "document_revision_id",
    "events",
    "version"
  ],
  "properties": {
    "dto_schema": {
      "const": "food-change-dto-v1"
    },
    "document_revision_id": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "price",
              "temporarily_unavailable",
              "supply_ended",
              "discontinued",
              "available",
              "substitution",
              "new_product"
            ]
          },
          "product_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "spec": {
            "type": [
              "string",
              "null"
            ]
          },
          "amount": {
            "type": [
              "string",
              "null"
            ]
          },
          "quantity": {
            "type": [
              "string",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "g",
              "kg",
              "ml",
              "l",
              "ea",
              "bag",
              "box",
              "pack",
              null
            ]
          },
          "effective_from": {
            "type": [
              "string",
              "null"
            ]
          },
          "effective_to": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "replacements": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "string"
            }
          },
          "price_basis": {
            "type": [
              "string",
              "null"
            ]
          },
          "uncertainties": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string"
            }
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "review": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "pending",
                  "confirmed",
                  "skipped"
                ]
              },
              "fields": {
                "type": "object"
              },
              "reason": {
                "type": "string"
              },
              "actor_id": {
                "type": "string"
              },
              "updated_at": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "id",
          "kind",
          "product_name",
          "spec",
          "amount",
          "quantity",
          "unit",
          "effective_from",
          "effective_to",
          "reason",
          "replacements",
          "price_basis",
          "uncertainties",
          "evidence_ids"
        ]
      }
    }
  }
}
