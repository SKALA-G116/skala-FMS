          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "product_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "variant_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "supplier_item_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "name": {
                  "type": "string"
                },
                "spec": {
                  "type": "string"
                },
                "supplier_name": {
                  "type": "string"
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                },
                "match_reasons": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "product_id",
                "variant_id",
                "supplier_item_id",
                "name",
                "spec",
                "supplier_name",
                "version",
                "match_reasons"
              ],
              "additionalProperties": false
            },
            "maxItems": 20
          }
