                "evidence_resource_uris": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "availability_status": {
                  "type": "string",
                  "enum": [
                    "available",
                    "temporarily_unavailable",
                    "supply_ended",
                    "unknown"
                  ]
                },
                "price_facts": {
                  "type": "array",
                  "maxItems": 10,
                  "items": {
                    "type": "object",
                    "properties": {
                      "fact_id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "value": {
                        "type": "object",
                        "properties": {
                          "amount": {
                            "type": "string",
                            "pattern": "^(0|[1-9]\\d*)(\\.\\d{1,4})?$",
                            "description": "음이 아닌 10진 문자열. 통화 단위 금액."
                          },
                          "currency": {
                            "type": "string",
                            "enum": [
                              "KRW"
                            ]
                          },
                          "quantity": {
                            "type": "string",
                            "pattern": "^(0|[1-9]\\d*)(\\.\\d{1,6})?$",
                            "description": "10진 문자열. 계산에는 decimal 사용."
                          },
                          "unit": {
                            "type": "string",
                            "enum": [
                              "g",
                              "kg",
                              "ml",
                              "l",
                              "ea",
                              "bag",
                              "box",
                              "pack"
                            ]
                          },
                          "tax": {
                            "type": "string",
                            "enum": [
                              "included",
                              "excluded",
                              "unknown"
                            ]
                          },
                          "price_kind": {
                            "type": "string",
                            "enum": [
                              "regular",
                              "promotion",
                              "contract",
                              "unknown"
                            ]
                          },
                          "condition_key": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "amount",
                          "currency",
                          "quantity",
                          "unit",
                          "tax",
                          "price_kind",
                          "condition_key"
                        ],
                        "additionalProperties": false,
                        "description": "quantity>0 업무 검증 필요. condition_key는 등록된 거래 조건. unknown 허용 여부는 업무 규칙에 따른다."
                      },
                      "effective_from": {
                        "type": "string",
                        "format": "date"
                      },
                      "effective_to": {
                        "anyOf": [
                          {
                            "type": "string",
                            "format": "date"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "effective_state": {
                        "type": "string",
                        "enum": [
                          "active",
                          "scheduled"
                        ]
                      }
                    },
                    "required": [
                      "fact_id",
                      "value",
                      "effective_from",
                      "effective_to",
                      "effective_state"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "supplier_item_id",
                "version",
                "fact_ids",
                "evidence_resource_uris",
                "summary",
                "availability_status",
                "price_facts"
              ],
              "additionalProperties": false
            },
            "maxItems": 20
          }
        },
        "required": [
          "as_of",
          "queried_at",
          "items"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "side_effects": "업무 데이터 조회만. 최신 값에 조회시각·version과 고정 근거 URI를 함께 반환.",
