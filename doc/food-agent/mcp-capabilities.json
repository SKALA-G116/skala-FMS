{
  "version": "0.2.0-draft",
  "design_manifest_only": true,
  "not_a_tools_list_wire_response": true,
  "server_name": "food-capability-server",
  "transport": "stdio",
  "server_instances": "분석 호스트 프로세스당 1개. API/OCR 프로세스에는 생성하지 않음.",
  "tools": [
    {
      "name": "parse_document_segment",
      "exposure": "host_only",
      "description": "고정 원문 버전의 한 segment에 대해 파서/OCR 작업을 등록한다. 원문 ID·segment ID만 받으며 임의 URL/경로를 받지 않는다. 결과는 추출 작업과 제한된 Resource 참조다. 업무 DB는 수정하지 않는다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "document_revision_id": {
            "type": "string",
            "format": "uuid"
          },
          "segment_id": {
            "type": "string",
            "format": "uuid"
          },
          "parser_profile": {
            "type": "string",
            "enum": [
              "native_text",
              "spreadsheet",
              "ocr_layout"
            ]
          }
        },
        "required": [
          "document_revision_id",
          "segment_id",
          "parser_profile"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "extraction_task_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "partial",
              "failed"
            ]
          },
          "extraction_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "resource_uris": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "extraction_task_id",
          "status",
          "extraction_id",
          "resource_uris",
          "warnings"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "side_effects": "추출 작업·불변 산출물·캐시 기록만 생성",
      "execution_context": "호스트가 제공하는 신뢰된 신원·run 범위·lease fencing token. 모델 입력값만으로 권한을 결정하지 않음.",
      "timeout_policy": "runtime-policy-v1",
      "max_result_bytes": 32768,
      "errors": [
        "INVALID_INPUT",
        "NOT_FOUND",
        "FORBIDDEN",
        "STALE_INPUT",
        "BUDGET_EXCEEDED",
        "TRANSIENT_UNAVAILABLE"
      ]
    },
