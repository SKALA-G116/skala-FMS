# ==============================================================================
# FMS_FILE_SPEC
# Dockerfile.food - 프로젝트 설정 Dockerfile.food
# ==============================================================================
# 설명:
#     - 프로젝트 설정 Dockerfile.food
# 입력·출력 명세:
#     - 입력: 도구별 설정·실행 환경
#     - 출력: 해당 도구의 구성 또는 실행 결과
# 실행 가정:
#     - 실제 비밀값과 로컬 실행 데이터는 Git에서 제외
# 작성 정보:
#     - 작성자: 미지정
#     - 이메일: 미지정
#     - 작성일: 2026-10-21 (최초 Git 등록일 기준)
#     - 라이선스: 미지정
#     - 버전: 0.1.0
#     - 상태: Development
# 변경 이력 (Revision History):
#     DATE        AUTHOR      VERSION  DESCRIPTION
#     --------------------------------------------------------------------
#     2026-10-21  미지정      v0.1.0   최초 Git 등록 a11ef05a
#     2026-10-21  미지정      v0.1.0   파일 역할·입출력·가정·이력 명세 추가
#
#     상세 Git 이력: git log --follow -- Dockerfile.food
#     공통 규칙: doc/file-header-policy.md
# ==============================================================================
FROM node:22-slim AS ui
WORKDIR /build
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build
FROM python:3.12-slim
WORKDIR /app
COPY backend/requirements.lock.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/ ./backend/
COPY migrations/ ./migrations/
COPY doc/food-agent/ ./doc/food-agent/
COPY --from=ui /build/dist ./frontend/dist
ENV FOOD_DATA_DIR=/data/assets
RUN useradd -m food && mkdir -p /data/assets && chown -R food:food /data /app
USER food
CMD ["uvicorn","backend.app.api.main:app","--host","0.0.0.0","--port","8100"]
